<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher panel: dark, so radio buttons and switches read on black. -->
    <style name="Theme.GEVR.Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#2873C2</item>
        <item name="colorControlActivated">#2873C2</item>
        <item name="colorControlNormal">#9AA4B0</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="LauncherHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#E0B040</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="LauncherRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="LauncherButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#1E5FA8</item>
        <item name="android:paddingLeft">30dp</item>
        <item name="android:paddingRight">30dp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
