<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude cache and temporary files -->
        <exclude domain="cache" />
        <exclude domain="no_backup" />
    </cloud-backup>
    <device-transfer>
        <!-- Include user data -->
        <include domain="file" />
        <include domain="external" />
    </device-transfer>
</data-extraction-rules>