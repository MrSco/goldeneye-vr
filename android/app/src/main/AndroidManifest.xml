<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gevr.port"
    android:installLocation="auto"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- OpenGL ES 3.2 required for OpenXR mobile & Fast3D multiview -->
    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="true" />

    <!-- VR headtracking -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />

    <uses-feature
        android:name="android.hardware.vr.highperformance"
        android:required="true" />

    <!--
        Declared so the shell does not gate launching on controllers.

        Without a hand-tracking declaration Quest's RequiresControllersLaunchInterceptor
        treats controllers as a hard requirement and blocks the launch behind
        LaunchCheckControllerRequiredDialogActivity. required="false" says the app
        runs either way; 6DOF aiming still wants controllers in practice.
    -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <!-- Haptics, Audio & Storage Permissions -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!--
        Launcher update check (UpdateChecker.java): read this repo's GitHub
        releases, download the new APK and hand it to the system installer.
        The player still confirms every install, and the first time allows
        "Install unknown apps" for this app.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- OpenXR permissions (Meta Quest) -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <!-- Queries block for OpenXR runtime broker -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!--
            Legacy GearVR-era marker that Meta's shell still reads to identify an
            app as VR. Both sideloaded apps checked on this headset that resolve
            their name in the universal menu (com.drbeef.jkxr,
            com.nintendont.virtualboygo) declare it and this one did not, which is
            the only manifest difference between them and us. Harmless either way.
        -->
        <meta-data
            android:name="com.samsung.android.vr.application.mode"
            android:value="vr_only" />

        <!-- Supported Meta devices (Quest specific) -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest|quest2|questpro|quest3|quest3s" />

        <!-- MainActivity = main immersive VR activity -->
        <!--
            label and icon are repeated here deliberately. Quest's shell reads the
            LAUNCHER activity's label and icon, not the application's, and does not
            fall back: with them unset the universal menu showed "App name
            unavailable" and no tile art. `aapt2 dump badging` shows the difference -
            launchable-activity must not report label='' icon=''.

            The icon points at a plain PNG rather than @mipmap/ic_launcher, which
            resolves to the adaptive-icon XML in mipmap-anydpi-v26 at every density.
            Quest does not reliably rasterise adaptive icons for sideloaded apps.
            The application below keeps the adaptive icon for ordinary Android.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher_quest"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density|layoutDirection|locale|smallestScreenSize"
            android:excludeFromRecents="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>

            <!-- Focus-aware VR (Meta specific) -->
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />
        </activity>

        <!--
            Issue #16: restarts the game into the launcher (RelaunchActivity.java).
            Its own process, so it outlives the game process it kills; it never
            draws and finishes in onCreate.
        -->
        <activity
            android:name=".RelaunchActivity"
            android:process=":relaunch"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!--
            No other 2D activities: the app is vr_only, and Quest's shell treated a 2D
            activity as the immersive app and waited for an XR session it never
            started (stuck in the loading space, 2026-09-23). ROM choice and
            options live in VR (port/vr/vr_launcher.cpp), the way single-activity
            vr_only apps such as VirtualBoyGo do them.
        -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.gevr.port.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
