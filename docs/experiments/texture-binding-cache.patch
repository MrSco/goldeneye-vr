new file mode 100644
index 0000000..cc5f9f2
--- /dev/null
+++ b/port/include/gevr_texture_bindings.h
@@ -0,0 +1,26 @@
+#ifndef GEVR_TEXTURE_BINDINGS_H
+#define GEVR_TEXTURE_BINDINGS_H
+#include <stdint.h>
+/* Actual GL bindings, separate from Fast3D's logical texture selection. The
+ * backend invalidates at frame/context boundaries and before deleting names.
+ * Non-2D targets keep their own GL bindings and always go to the driver. */
+struct GevrTextureBindings {
+    int unit = -1;
+    uint32_t textures[2] = {};
+    bool known[2] = {};
+    void invalidate() { unit = -1; known[0] = known[1] = false; }
+    bool active(unsigned next) {
+        if (next > 1) { invalidate(); return true; }
+        if (unit == (int)next) return false;
+        unit = (int)next;
+        return true;
+    }
+    bool bind(uint32_t texture) {
+        if (unit < 0) return true;
+        if (known[unit] && textures[unit] == texture) return false;
+        textures[unit] = texture;
+        known[unit] = true;
+        return true;
+    }
+};
+#endif
