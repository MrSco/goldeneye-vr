<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>GoldenEye VR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GoldenEye VR</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The app icon is Assets.xcassets' AppIcon (tools/make_icons.py); actool
	     adds CFBundleIcons and CFBundleIconName at build time. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Required by the iOS 27 SDK (UIKit kills an app without it).
	     GevrSceneDelegate (port/ios/ios_app.m) moves SDL's sceneless window
	     onto the scene. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>GevrSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<!-- The ROM, goldeneye-vr.ini, saves and logs live in Documents
	     (port/src/main.c), which the Files app shows as "GoldenEye VR". -->
	<!-- A game that reads game controllers itself (SDL, through GameController):
	     without these, visionOS also drove the iPad app's UI with a connected
	     pad (its sticks and D-pad as arrow keys, A as Return; 2026-11-14). -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Voice chat in multiplayer (port/src/net/net_voice.c) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GoldenEye VR uses the microphone for voice chat in multiplayer.</string>
	<!-- Games on the same network (LAN lobbies, direct connect) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>GoldenEye VR uses the local network to find and join multiplayer games.</string>
	<!-- Never prompted for (SDL's Steam BLE backend is off, port/ios/ios_app.m);
	     iOS kills an app that reaches CoreBluetooth without these. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>GoldenEye VR can connect to Bluetooth game controllers.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>GoldenEye VR can connect to Bluetooth game controllers.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- 120 Hz on ProMotion iPhones -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iCloud sync (port/ios/ios_icloud.mm): YES only in a build signed with
	     port/ios/gevr-icloud.entitlements (tools/build_*.sh with GEVR_ICLOUD=1) -->
	<key>GEVRICloud</key>
	<string>$(GEVR_ICLOUD)</string>
</dict>
</plist>
