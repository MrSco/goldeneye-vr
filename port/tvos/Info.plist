<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>GoldenEye VR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GoldenEye VR</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The home screen's icon and the Top Shelf are Assets.xcassets'
	     "App Icon & Top Shelf Image" (tools/make_icons.py); actool adds the
	     icon keys at build time. -->
	<!-- The tvOS 27 SDK wants a scene manifest as the iOS 27 one does.
	     GevrSceneDelegate (port/ios/ios_app.m) moves SDL's sceneless window
	     onto the scene. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>GevrSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- The game reads its controllers itself (SDL, through GameController):
	     a pad, and the Siri Remote for the launcher. -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<!-- #269: without these two a 2nd generation Siri Remote comes as a
	     "Coalesced Remote" with the 1st generation's inputs only (tvOS 26):
	     no Cardinal Direction Pad, no Button Center, and its ring clicks
	     nowhere ("the combined micro gamepads won't have the extra inputs
	     of the 2nd Generation Siri Remote", GCSupportsMultipleMicroGamepads).
	     DirectionalGamepad is the 2nd generation's profile. A remote is
	     never a player's pad while a full pad is there (input.c). -->
	<key>GCSupportsMultipleMicroGamepads</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>DirectionalGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>MicroGamepad</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Voice chat in multiplayer (port/src/net/net_voice.c) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GoldenEye VR uses the microphone for voice chat in multiplayer.</string>
	<!-- Your ROM from a phone or computer (port/tvos/tvos_upload.mm), and
	     games on the same network (LAN lobbies, direct connect) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>GoldenEye VR uses the local network to receive your ROM from a phone or computer, and to find and join multiplayer games.</string>
	<!-- Never prompted for (SDL's Steam BLE backend is off, port/ios/ios_app.m) -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>GoldenEye VR can connect to Bluetooth game controllers.</string>
</dict>
</plist>
